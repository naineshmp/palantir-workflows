{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/single-cell-qc-pipeline//nextflow_schema.json",
  "title": "single-cell-qc-pipeline pipeline parameters",
  "description": "Pipeline for processing single-cell QC metrics",
  "type": "object",
  "$defs": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "required": ["outdir"],
      "properties": {
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
          "fa_icon": "fas fa-folder-open"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/input_output_options"
    }
  ],
  "properties": {
    "supersample_basename": {
      "type": "string"
    },
    "num_input_cells": {
      "type": "string"
    },
    "samplesheet": {
      "type": "string"
    },
    "supersample_id": {
      "type": "string"
    },
    "run_guide_assignment": {
      "type": "string"
    },
    "min_valid_guides": {
      "type": "string"
    },
    "max_valid_guides": {
      "type": "string"
    }
  }
}
